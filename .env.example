# Copy this file to .env.local and adjust for your machine.
DATABASE_URL=postgres://your_user@localhost:5432/aipod

# Where notes and scripts are read from (see docs/architecture.md).
# Development: a local folder. Relative paths are resolved from the repo root.
NOTES_DIR=./notes-template
# Production: the private notes repo on GitHub. Used when NOTES_DIR is unset.
# NOTES_REPO=your-name/aipod-notes
# NOTES_REF=main
# A fine-grained token with read-only "Contents" access to the notes repo.
# NOTES_TOKEN=
# Secret shared with the GitHub push webhook that triggers a sync.
# SYNC_WEBHOOK_SECRET=
